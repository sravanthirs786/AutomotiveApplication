[Unit]
Description=Allowlisted gateway between diagnostic and internal vehicle CAN domains
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/vehicle-sim/secure_gateway.py --external vcan_diag --internal vcan0
Restart=on-failure
RestartSec=2
User=vehiclesim
Group=vehiclesim
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
